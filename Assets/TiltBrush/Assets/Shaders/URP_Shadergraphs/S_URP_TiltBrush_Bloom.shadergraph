    "m_SourceType": 1,
    "m_FunctionName": "Bloom",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 boosted = VertColor * exp(EmissionGain * 3.0);\nColor = boosted * float3(TexR, TexG, TexB) * TexA * VertA;\nAlpha = 1.0;"
}

